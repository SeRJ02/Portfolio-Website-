---
import '../styles/hero3d.css';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.jsx';
import WorkSection from '../components/WorkSection.astro';
import ThinkingSection from '../components/ThinkingSection.astro';
import BentoSection from '../components/BentoSection.astro';
import DevTweaks from '../components/DevTweaks.jsx';

const isDev = import.meta.env.DEV;
---
<Base title="Akshat Somani — Product Manager" footerVariant="home">
  <Hero client:visible />
  <WorkSection />
  <ThinkingSection />
  <BentoSection />
  {isDev && <DevTweaks client:only="react" />}
</Base>
